				"import subprocess\n",
				"import sys\n",
				"import time\n",
				"from io import StringIO\n",
				"import xml.etree.ElementTree as ET\n",
				"\n",
				"import pandas as pd\n",
				"import plotly.express as px\n",
				"import requests\n",
				"\n",
				"# Sobe a API Flask local em background para uso como proxy\n",
				"_api_proc = subprocess.Popen([sys.executable, \"api_flask.py\"])\n",
				"time.sleep(2)\n",
				"print(\"API Flask iniciada em http://127.0.0.1:5000\")\n"
			]
		},
		{
			"cell_type": "code",
			"metadata": {
				"language": "python"
			},
			"source": [
				"BASE_URL = \"http://127.0.0.1:5000\"\n",
				"\n",
				"def coletar_dados_flask(rota):\n",
				"    \"\"\"Coleta dados da API Flask local e retorna JSON (dict) ou XML (str).\"\"\"\n",
				"    url = f\"{BASE_URL}{rota}\"\n",
				"    resp = requests.get(url, timeout=180)\n",
				"    resp.raise_for_status()\n",
				"\n",
				"    content_type = resp.headers.get(\"Content-Type\", \"\").lower()\n",
				"    if \"xml\" in content_type or rota == \"/api/ana\":\n",
				"        return resp.text\n",
				"    return resp.json()\n",
				"\n",
				"def _xml_ana_para_dataframe(xml_text):\n",
				"    \"\"\"Converte XML da ANA em DataFrame bruto (formato amplo: Cota01..Cota31).\"\"\"\n",
				"    root = ET.fromstring(xml_text)\n",
				"    rows = []\n",
				"\n",
				"    for node in root.iter():\n",
				"        children = list(node)\n",
				"        if not children:\n",
				"            continue\n",
				"\n",
				"        tags = [c.tag.split(\"}\")[-1] for c in children]\n",
				"        if any(t.startswith(\"Cota\") for t in tags):\n",
				"            row = {}\n",
				"            for child, tag in zip(children, tags):\n",
				"                row[tag] = (child.text or \"\").strip()\n",
				"            rows.append(row)\n",
				"\n",
				"    if rows:\n",
				"        return pd.DataFrame(rows)\n",
				"\n",
				"    # Fallback para estruturas SOAP diferentes\n",
				"    try:\n",
				"        return pd.read_xml(StringIO(xml_text))\n",
				"    except Exception:\n",
				"        return pd.DataFrame()\n",
				"\n",
				"def limpar_dados_ana(df):\n",
				"    \"\"\"Limpa dados da ANA, aplica melt nas colunas CotaXX e cria serie diaria de nivel.\"\"\"\n",
				"    if df.empty:\n",
				"        return df\n",
				"\n",
				"    df = df.copy()\n",
				"\n",
				"    # Detecta coluna de referencia temporal mensal\n",
				"    candidatos_data = [\"Data\", \"DataHora\", \"DataMedicao\", \"DataReferencia\"]\n",
				"    col_data = next((c for c in candidatos_data if c in df.columns), None)\n",
				"\n",
				"    if col_data is None:\n",
				"        # Tenta inferir pelo nome da coluna contendo 'Data'\n",
				"        col_data = next((c for c in df.columns if \"data\" in c.lower()), None)\n",
				"\n",
				"    if col_data is None:\n",
				"        raise ValueError(\"Nao foi encontrada coluna de data na base da ANA.\")\n",
				"\n",
				"    df[col_data] = pd.to_datetime(df[col_data], dayfirst=True, errors=\"coerce\")\n",
				"\n",
				"    cota_cols = [c for c in df.columns if c.startswith(\"Cota\")]\n",
				"    if not cota_cols:\n",
				"        raise ValueError(\"Nao foram encontradas colunas CotaXX na base da ANA.\")\n",
				"\n",
				"    df_long = df.melt(\n",
				"        id_vars=[col_data],\n",
				"        value_vars=cota_cols,\n",
				"        var_name=\"dia_coluna\",\n",
				"        value_name=\"cota_m\"\n",
				"    )\n",
				"\n",
				"    df_long[\"dia\"] = df_long[\"dia_coluna\"].str.extract(r\"(\\d{1,2})\").astype(float)\n",
				"\n",
				"    # Reconstrucao da data diaria: ano/mes da coluna base + dia extraido de CotaXX\n",
				"    base_mes = df_long[col_data].dt.to_period(\"M\").dt.to_timestamp()\n",
				"    df_long[\"data\"] = base_mes + pd.to_timedelta(df_long[\"dia\"] - 1, unit=\"D\")\n",
				"\n",
				"    df_long[\"cota_m\"] = (\n",
				"        df_long[\"cota_m\"]\n",
				"        .astype(str)\n",
				"        .str.replace(\",\", \".\", regex=False)\n",
				"    )\n",
				"    df_long[\"cota_m\"] = pd.to_numeric(df_long[\"cota_m\"], errors=\"coerce\")\n",
				"\n",
				"    df_long = df_long.dropna(subset=[\"data\", \"cota_m\"])\n",
				"    df_long = df_long.loc[(df_long[\"dia\"] >= 1) & (df_long[\"dia\"] <= 31)]\n",
				"\n",
				"    return df_long[[\"data\", \"cota_m\"]].sort_values(\"data\").reset_index(drop=True)\n",
				"\n",
				"def limpar_dados_meteo(df):\n",
				"    \"\"\"Limpa dados meteorologicos diarios da Open-Meteo.\"\"\"\n",
				"    if df.empty:\n",
				"        return df\n",
				"\n",
				"    df = df.copy()\n",
				"    if \"time\" in df.columns:\n",
				"        df = df.rename(columns={\"time\": \"data\"})\n",
				"\n",
				"    df[\"data\"] = pd.to_datetime(df[\"data\"], errors=\"coerce\")\n",
				"    for col in [\"precipitation_sum\", \"rain_sum\"]:\n",
				"        if col in df.columns:\n",
				"            df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
				"\n",
				"    return df.dropna(subset=[\"data\"]).sort_values(\"data\").reset_index(drop=True)\n"
			]
		},
