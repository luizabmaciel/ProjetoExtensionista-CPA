				"# 3) EDA com Plotly\n",
				"# 3.1 Chuva acumulada em maio/2024 (Open-Meteo)\n",
				"df_maio = df_meteo_limpo.loc[\n",
				"    (df_meteo_limpo[\"data\"] >= \"2024-05-01\") &\n",
