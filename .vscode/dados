				"# 1) Coleta BRUTA (antes do tratamento)\n",
				"meteo_json = coletar_dados_flask(\"/api/meteo\")\n",
				"ana_xml = coletar_dados_flask(\"/api/ana\")\n",
				"\n",
				"df_meteo_bruto = pd.DataFrame(meteo_json.get(\"daily\", {}))\n",
				"df_ana_bruto = _xml_ana_para_dataframe(ana_xml)\n",
				"\n",
